# Copie para .env.local — nunca commite segredos.

FG_SESSION_SECRET=troque-por-uma-string-longa-aleatoria

# Contas de operação (só servidor). Deixe vazio em produção com Supabase Auth.
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
AUTH_ADMIN_NAME=Administrador

AUTH_USER_EMAIL=
AUTH_USER_PASSWORD=
AUTH_USER_NAME=Vendedor

AUTH_SUPER_EMAIL=
AUTH_SUPER_PASSWORD=
AUTH_SUPER_NAME=Super Admin

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mercado Pago (nunca NEXT_PUBLIC)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
APP_URL=https://seu-dominio.com
BILLING_PRICE_BRL=99

# Emissão fiscal — só servidor (nunca NEXT_PUBLIC). XML é gerado pelo provedor.
# Não grave token/CSC em tabela Postgres em texto. Use Vault (UUID em fiscal_issuers)
# ou estas variáveis. Ver supabase/fiscal.sql.
FISCAL_ENVIRONMENT=homologation
FISCAL_UF=RO
FISCAL_ISSUER_CNPJ=
FISCAL_ISSUER_IE=
FISCAL_PROVIDER_TOKEN=
FISCAL_CSC_ID=
FISCAL_CSC_TOKEN=
